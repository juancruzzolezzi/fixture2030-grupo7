        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estado de salud por base",
      "description": "database_up: la API prueba cada base cada 15 s (ping o lectura minima). CAIDA en una sola base: sus rutas dan 503/504 y el resto sigue. Accion: docker compose ps y logs de esa base.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "database_up",
          "legendFormat": "{{database}}",
          "refId": "A",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 14,
        "x": 0,
        "y": 6
