# Configuracion de la evaluacion del Hito 11 (sin secretos).
# Copiar a config/local.env si hace falta cambiar algo; si no existe se usan estos valores.
#
# La conexion a las bases (hosts, puertos, usuarios, passwords, token de Influx)
# NO va aca: el script la lee del .env del Hito 10, que es el mismo que usa la API.

API_URL=http://localhost:8000
NEO4J_HTTP_URL=http://localhost:7474
IRIS_PORTAL_URL=http://localhost:52773

# Segundos maximos de espera de cada prueba
TIMEOUT_S=3
