# Hito 12 - parametros de la prueba de carga (sin secretos).
# Para cambiar algo: copiar este archivo a config/local.env (no se versiona) y
# editarlo ahi. Las credenciales (token de InfluxDB) se leen del .env del Hito 10.

# La prueba levanta su propia instancia de la API en este puerto (no usa la del 8000)
PUERTO_API=8010

# Datos de laboratorio: keyspace y base propios, separados de los del Hito 10
KEYSPACE_PRUEBA=fixture2030_h12
INFLUX_DB_PRUEBA=fixture2030_h12
PARTIDO=F2030-006
COMENTARIOS_POR_BLOQUE=300

# Escenario: usuarios virtuales que repiten una operacion cada 1/OPS_POR_USUARIO_S segundos
USUARIOS_VIRTUALES=30
OPS_POR_USUARIO_S=2
CALENTAMIENTO_S=10
RAMPA_S=20
SOSTENIMIENTO_S=60

# Mezcla de operaciones (porcentajes, suman 100)
MEZCLA_LEER_COMENTARIOS=60
MEZCLA_PUBLICAR_COMENTARIO=20
MEZCLA_LEER_ESTADISTICAS=20

# Limites: timeout de cada request y corte de la prueba si los errores pasan este %
TIMEOUT_REQUEST_S=10
CORTE_ERRORES_PCT=20
