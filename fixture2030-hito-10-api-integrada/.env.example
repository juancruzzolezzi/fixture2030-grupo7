# Copiar a .env (no se versiona) antes de correr scripts/iniciar_api.sh.
# Son los valores del ambiente local de laboratorio, iguales a los que ya
# documentaron los Hitos 4 a 9 para cada base (RNF6).

MONGO_URI=mongodb://fixture_admin:fixture2030@localhost:27017/?authSource=admin
MONGO_DB=fixture2030

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fixture2030_local

CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

INFLUX_URL=http://localhost:8181
INFLUX_DATABASE=fixture2030_series
# Generado por scripts/influxdb/sembrar.sh en .influxdb3-token; pegar el valor aca.
INFLUX_TOKEN=

IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=_SYSTEM
IRIS_PASSWORD=SYS
