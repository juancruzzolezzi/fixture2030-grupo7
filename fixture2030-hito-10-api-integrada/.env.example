# Copiar a .env (no se versiona) y reemplazar los tres valores CAMBIAR_... por
# passwords propias. Docker Compose lee este mismo .env para crear los usuarios
# de MongoDB y Neo4j, y scripts/sembrar_datos.sh le pone a IRIS la password de aca.
#
# Los hosts son 127.0.0.1 y no "localhost": en Windows, "localhost" prueba
# primero IPv6 y, como InfluxDB e IRIS solo escuchan en IPv4, cada conexion
# perdia ~2 s antes de reintentar (lo vimos en el Hito 11).

MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=fixture_admin
MONGO_PASSWORD=CAMBIAR_password_mongo
MONGO_DB=fixture2030

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CAMBIAR_password_neo4j

CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

INFLUX_URL=http://127.0.0.1:8181
INFLUX_DATABASE=fixture2030_series
# Lo completa scripts/sembrar_datos.sh (sale de .influxdb3-token, que tampoco se versiona).
INFLUX_TOKEN=

IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=_SYSTEM
IRIS_PASSWORD=CAMBIAR_password_iris
