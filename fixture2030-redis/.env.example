# El docker-compose.yml monta los datos en ${HOME}/docker/data/redis, según la
# convención de la materia (RNF2).
#
# En Linux y macOS la variable HOME ya existe y no hace falta hacer nada.
#
# En Windows NO existe una variable de entorno HOME (PowerShell tiene $HOME,
# pero es una variable interna de PowerShell, no del sistema), así que Docker
# Compose la resolvería como texto vacío y el montaje fallaría.
#
# Solución: copiar este archivo como .env y poner abajo la ruta del perfil de
# usuario, con barras normales. Para saber cuál es, en PowerShell:
#     echo $env:USERPROFILE
#
# Ejemplo (reemplazar por el usuario real de cada notebook):
HOME=C:/Users/TU_USUARIO
